# Base URL of your Laravel API (no trailing slash). Use full URL when API is on another host.
VITE_API_URL=http://localhost:8000/api
# Reverb WebSocket (optional – for live data updates without refresh)
VITE_REVERB_APP_KEY=cm-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=ws
